{
  "name": "craft-and-board",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev:web": "./scripts/pnpm --filter web dev",
    "dev:api": "./scripts/pnpm --filter api dev",
    "dev:worker": "./scripts/pnpm --filter worker dev",
    "dev": "concurrently -n web,api,worker -c green,blue,yellow \"./scripts/pnpm dev:web\" \"./scripts/pnpm dev:api\" \"./scripts/pnpm dev:worker\"",
    "build": "./scripts/pnpm -r build",
    "lint": "./scripts/pnpm -r lint",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "build:api": "chmod +x node_modules/.bin/* 2>/dev/null; ./scripts/pnpm exec prisma generate --schema prisma/schema.prisma && ./scripts/pnpm --filter api... build",
    "start:api": "./scripts/pnpm --filter api start",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "hq:seed": "./scripts/pnpm --filter api exec tsx ../../prisma/seed-hq.ts"
  },
  "devDependencies": {
    "@prisma/client": "^6.5.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2"
  }
}
