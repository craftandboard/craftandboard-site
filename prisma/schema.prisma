  updatedAt                        DateTime                             @updatedAt
  requestId                        String                               @unique
  status                           CraftBoardStorefrontOrderAttemptStatus @default(RECEIVED)
  sourceChannel                    String
  productFamily                    String
  productSlug                      String
  configurationJson                Json
  pricingJson                      Json
  customerJson                     Json
  shippingJson                     Json
  billingJson                      Json?
  paymentMode                      CraftBoardStorefrontPaymentMode
  orderIntent                      CraftBoardStorefrontOrderIntent
  instantPriceEligible             Boolean                              @default(false)
  consultRequired                  Boolean                              @default(false)
  customerAcceptedPricingBasis     Boolean                              @default(false)
  customerAcceptedLeadTimeBasis    Boolean                              @default(false)
  customerAcknowledgedMadeToOrder  Boolean                              @default(false)
  shippingMode                     CraftBoardStorefrontShippingMode?
  packagingProfile                 CraftBoardStorefrontPackagingProfile?
  shippingCostCents                Int?
  shippingReviewRequired           Boolean                              @default(false)
  estimatedTransitDays             Int?
  destinationZone                  String?
  shippingBasisVersion             String?
  shippingQuoteSource              CraftBoardStorefrontShippingQuoteSource?
  shippingCarrierName              String?
  shippingServiceLevel             String?
  shippingQuoteReference           String?
  shippingQuoteExpiresAt           DateTime?
  shippingQuoteGeneratedAt         DateTime?
  shippingFallbackUsed             Boolean                              @default(false)
  shippingEstimateJson             Json?
  shippingWarningsJson             Json?
  shippingProviderSummaryJson      Json?
  taxAmountCents                   Int?
  taxableSubtotalCents             Int?
  taxableShippingCents             Int?
  taxReviewRequired                Boolean                              @default(false)
  taxQuoteSource                   CraftBoardStorefrontTaxQuoteSource?
  taxRateBasisPoints               Int?
  taxBasisVersion                  String?
  taxQuoteGeneratedAt              DateTime?
  taxQuoteExpiresAt                DateTime?
  taxFallbackUsed                  Boolean                              @default(false)
  taxJurisdictionSummaryJson       Json?
  taxWarningsJson                  Json?
  taxReasonCodesJson               Json?
  taxProviderSummaryJson           Json?
  paymentStatus                    CraftBoardStorefrontPaymentStatus    @default(NOT_STARTED)
  depositPercentBasisPoints        Int?
  depositAmountCents               Int?
  remainingBalanceAmountCents      Int?
  paymentProvider                  String?
  paymentProviderSessionId         String?
  paymentProviderIntentId          String?
  paymentInitiatedAt               DateTime?
  paidAt                           DateTime?
  cancelledAt                      DateTime?
  paymentFailureReason             String?
  fieldMetriqSubmissionEnabled     Boolean                              @default(false)
  fieldMetriqSubmissionAttemptedAt DateTime?
  fieldMetriqSubmissionStatus      CraftBoardFieldMetriqSubmissionStatus @default(NOT_ATTEMPTED)
  fieldMetriqSubmissionSucceededAt DateTime?
  fieldMetriqSubmissionReference   String?
  fieldMetriqSubmissionError       String?
  fieldMetriqSubmissionRetryCount  Int                                  @default(0)
  fieldMetriqSubmittedAt           DateTime?
  fieldMetriqFulfillmentClass      CraftBoardFulfillmentClass?
  fieldMetriqProductionProfile     CraftBoardProductionProfile?
  customerStatusToken              String?                              @unique
  customerStatusTokenCreatedAt     DateTime?
  latestCustomerOrderStatus        CraftBoardCustomerOrderStatus?
  latestCustomerOrderStatusLabel   String?
  latestCustomerStatusUpdatedAt    DateTime?
  fieldMetriqOrderReference        String?
  fieldMetriqOrderStatusSnapshotJson Json?
  fieldMetriqLastStatusSyncAt      DateTime?
  customerStatusTimelineJson       Json?
  customerStatusLastViewedAt       DateTime?
  orderConfirmationEmailSentAt     DateTime?
  paymentReceiptEmailSentAt        DateTime?
  lastCustomerStatusEmailed        CraftBoardCustomerOrderStatus?
  lastCustomerStatusEmailedAt      DateTime?
  fallbackReason                   String?
  resolvedOrderId                  String?
  confirmationCode                 String?
  organization                     Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resolvedInquiry                  CraftBoardInquiry?                   @relation(fields: [resolvedInquiryId], references: [id], onDelete: SetNull)
  notificationLogs                 CraftBoardNotificationLog[]
  changeRequests                   CraftBoardChangeRequest[]
  orderIssues                      CraftBoardOrderIssue[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, productFamily])
  @@index([organizationId, shippingMode])
  @@index([organizationId, shippingQuoteSource])
  @@index([organizationId, taxQuoteSource])
  @@index([organizationId, fieldMetriqSubmissionStatus], map: "CBStorefrontAttempt_org_submission_status_idx")
  @@index([organizationId, fieldMetriqFulfillmentClass], map: "CBStorefrontAttempt_org_fulfillment_class_idx")
  @@index([customerStatusToken])
  @@index([organizationId, latestCustomerOrderStatus])
  @@index([fieldMetriqSubmissionReference])
  @@index([paymentProviderSessionId])
  @@index([paymentProviderIntentId])
  @@index([shippingQuoteReference])
  @@index([resolvedInquiryId])
}

