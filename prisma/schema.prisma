  reviewedWidthUnit          String
  reviewedDepthValue         Decimal?
  reviewedDepthUnit          String
  reviewedThicknessValue     Decimal?
  reviewedThicknessUnit      String
  reviewedQuantity           Int
  reviewedMaterialCode       String?
  reviewedMaterialLabel      String?
  reviewedMountingCode       String?
  reviewedMountingLabel      String?
  proposalSubtotalAmountCents Int
  proposalDiscountAmountCents Int
  proposalShippingAmountCents Int
  proposalTotalAmountCents   Int
  depositAmountPaidCents     Int
