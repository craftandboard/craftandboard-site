model Proposal {
  id             String            @id
  organizationId String
  projectId      String?
  leadId         String?
  title          String?
  status         String?
  version        Int               @default(1)
  publicToken    String?           @unique
  depositPolicy  ProposalDepositPolicy @default(NO_DEPOSIT_REQUIRED)
