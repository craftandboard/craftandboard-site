model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]    @relation("UserDefaultOrganization")
  memberships OrganizationMember[]
  settings  OrgSettings?
  orders    Order[]
  orderItems OrderItem[]
  projects   Project[]
  projectPhases ProjectPhase[]
  projectTasks ProjectTask[]
  leads     Lead[]
  proposals Proposal[]
  proposalSections ProposalSection[]
  proposalLines ProposalLine[]
  depositRequests DepositRequest[]
  payments Payment[]
  paymentExecutions PaymentExecution[]
  paymentProviderEvents PaymentProviderEvent[]
  paymentReconciliationLogs PaymentReconciliationLog[]
  proposalAcceptances ProposalAcceptance[]
  proposalConversions ProposalConversion[]
  proposalOrchestrationLogs ProposalOrchestrationLog[]
  proposalAcceptanceIntakes ProposalAcceptanceIntake[]
  proposalAcceptanceEvidence ProposalAcceptanceEvidence[]
  proposalAcceptanceIntakeLogs ProposalAcceptanceIntakeLog[]
  proposalAcceptanceReviewLogs ProposalAcceptanceReviewLog[]
  proposalAcceptancePresentationLogs ProposalAcceptancePresentationLog[]
  pilotFeedbacks PilotFeedback[]
  parts     Part[]
  batches   Batch[]
  bundles   ProductionBundle[]
  sheets    Sheet[]
  sheetPlacements SheetPlacement[]
  cncJobs   CncJob[]
  stations  Station[]
  scanEvents ScanEvent[]
  shipments Shipment[]
  artifacts Artifact[]
  machineProfiles  MachineProfile[]
  materialProfiles MaterialProfile[]
  manufacturingJobs ManufacturingJob[]
  containers Container[]
  partContainerAssignments PartContainerAssignment[]
  remnants Remnant[]
  remnantUsages RemnantUsage[]
  remnantMovements RemnantMovement[]
  remnantAllocations RemnantAllocation[]
  machines  Machine[]
  machineEventIngestRuns MachineEventIngestRun[]
  machineEvents MachineEvent[]
  machineEventLinks MachineEventLink[]
  machineStageCandidates MachineStageCandidate[]
  stageCandidateSignals StageCandidateSignal[]
  trustedAutoApplyRules TrustedAutoApplyRule[]
  costProfiles CostProfile[]
  costRates CostRate[]
  costScenarios CostScenario[]
  materialCostRules MaterialCostRule[]
  edgeBandCostRules EdgeBandCostRule[]
  packagingCostRules PackagingCostRule[]
  shippingCostRules ShippingCostRule[]
  amazonFeePresets AmazonFeePreset[]
  shippingZoneRules ShippingZoneRule[]
  shelfCostCalculations ShelfCostCalculation[]
  calculationScenarios CalculationScenario[]
  calculationComparisonSets CalculationComparisonSet[]
  comparisonSetScenarios ComparisonSetScenario[]
  launchTemplates LaunchTemplate[]
  launchGuardrailProfiles LaunchGuardrailProfile[]
  marketplaceMappingTemplates MarketplaceMappingTemplate[]
  channelMappingPresets ChannelMappingPreset[]
  listingPrepPackages ListingPrepPackage[]
  shelfCostEstimates ShelfCostEstimate[]
  orderCostEstimates OrderCostEstimate[]
  shelfProducts ShelfProduct[]
  productionAssumptionProfiles ProductionAssumptionProfile[]
  packagingProfiles PackagingProfile[]
  pricingPolicies PricingPolicy[]
  pricingScenarios PricingScenario[]
  salesOrders SalesOrder[]
  salesOrderItems SalesOrderItem[]
  shelfJobs ShelfJob[]
  manufacturingPackets ManufacturingPacket[]
  manufacturingParts ManufacturingPart[]
  manufacturingBatches ManufacturingBatch[]
  manufacturingBatchParts ManufacturingBatchPart[]
  labelTemplateVersions LabelTemplateVersion[]
  packetExpansionRuns PacketExpansionRun[]
  labelRenderJobs LabelRenderJob[]
  workflowStationRules WorkflowStationRule[]
  containerLocations ContainerLocation[]
  containerAssignments ContainerAssignment[]
  containerMoveEvents ContainerMoveEvent[]
  activeContainerSessions ActiveContainerSession[]
}

model OrgSettings {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  timezone             String
  currency             String
  defaultUnitSystem    UnitSystem   @default(IMPERIAL)
  bootstrapDefaultsJson Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  name           String?
  passwordHash   String?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation("UserDefaultOrganization", fields: [organizationId], references: [id])
  memberships    OrganizationMember[]
  sessions       Session[]
  activationTokens ActivationToken[]
  passwordResetTokens PasswordResetToken[]
  assignedProjectTasks ProjectTask[]
  costScenarios  CostScenario[]
  pricingScenarios PricingScenario[]
  shelfCostEstimates ShelfCostEstimate[]
  orderCostEstimates OrderCostEstimate[]
  manufacturingPackets ManufacturingPacket[]
  packetExpansionRuns PacketExpansionRun[]
  scanEvents           ScanEvent[]             @relation("ScanEventScannedByUser")
  labelRenderJobs      LabelRenderJob[]
  assignedContainerAssignments ContainerAssignment[] @relation("ContainerAssignmentAssignedByUser")
  unassignedContainerAssignments ContainerAssignment[] @relation("ContainerAssignmentUnassignedByUser")
  containerMoveEvents  ContainerMoveEvent[]    @relation("ContainerMoveEventMovedByUser")
  activeContainerSessionsStarted ActiveContainerSession[] @relation("ActiveContainerSessionStartedByUser")
  activeContainerSessionsEnded   ActiveContainerSession[] @relation("ActiveContainerSessionEndedByUser")
  remnantMoves        RemnantMovement[]        @relation("RemnantMovementMovedByUser")
  createdRemnantAllocations RemnantAllocation[] @relation("RemnantAllocationCreatedByUser")
  releasedRemnantAllocations RemnantAllocation[] @relation("RemnantAllocationReleasedByUser")
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationMemberRole @default(OPERATOR)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id])
  organization   Organization           @relation(fields: [organizationId], references: [id])
  reviewedStageCandidateSignals StageCandidateSignal[] @relation("StageCandidateReviewedBy")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model PilotFeedback {
  id                String              @id @default(cuid())
  organizationId    String
  membershipId      String?
  area              PilotFeedbackArea
  severity          PilotFeedbackSeverity
  status            PilotFeedbackStatus @default(NEW)
  pagePath          String?
  title             String
  message           String
  reproductionNotes String?
  screenshotUrl     String?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, area])
  @@index([organizationId, severity])
  @@index([organizationId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  key            String?
  name           String
  address        String?
  status         String?
  stage          String?
  scopeSummary   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  leads          Lead[]
  proposals      Proposal[]
  proposalConversions ProposalConversion[]
  phases         ProjectPhase[]
  tasks          ProjectTask[]

  @@unique([organizationId, key])
  @@index([organizationId, updatedAt])
  @@index([organizationId, stage])
}

model ProjectPhase {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  status         String?
  summary        String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          ProjectTask[]

  @@unique([projectId, name])
  @@index([organizationId, projectId, sortOrder])
}

model ProjectTask {
  id               String       @id @default(cuid())
  organizationId   String
  projectId        String
  phaseId          String?
  title            String
  status           String       @default("OPEN")
  dueDate          DateTime?
  assignedToUserId String?
  isRequired       Boolean      @default(false)
  sortOrder        Int          @default(0)
  sourceKey        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id])
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase            ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assignedToUser   User?        @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
  @@index([projectId, phaseId, sortOrder])
  @@index([projectId, status])
  @@index([assignedToUserId, dueDate])
  @@unique([organizationId, projectId, sourceKey])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  name           String
  email          String?
  phone          String?
  address        String?
  status         String?
  stage          String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  proposals      Proposal[]
  proposalConversions ProposalConversion[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, stage])
}

model Proposal {
  id             String            @id
  organizationId String
  projectId      String?
  leadId         String?
  title          String?
  status         String?
  version        Int               @default(1)
  publicToken    String?           @unique
  depositPolicy  ProposalDepositPolicy @default(NO_DEPOSIT_REQUIRED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sections       ProposalSection[]
  lines          ProposalLine[]
  depositRequests DepositRequest[]
  payments       Payment[]
  paymentExecutions PaymentExecution[]
  paymentProviderEvents PaymentProviderEvent[]
  acceptance     ProposalAcceptance?
  conversion     ProposalConversion?
  orchestrationLogs ProposalOrchestrationLog[]
  acceptanceIntakes ProposalAcceptanceIntake[]
  acceptanceEvidence ProposalAcceptanceEvidence[]
  acceptanceIntakeLogs ProposalAcceptanceIntakeLog[]
  acceptanceReviewLogs ProposalAcceptanceReviewLog[]
  acceptancePresentationLogs ProposalAcceptancePresentationLog[]

  @@index([organizationId, projectId])
  @@index([organizationId, leadId])
  @@index([organizationId, status])
}

model ProposalSection {
  id             String       @id @default(cuid())
  organizationId String
  proposalId     String
  title          String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  proposal       Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  lines          ProposalLine[]

  @@index([organizationId, proposalId])
  @@index([proposalId, sortOrder])
}

model ProposalLine {
  id             String           @id @default(cuid())
  organizationId String
  proposalId     String
  sectionId      String?
  name           String
  description    String?
  qty            Decimal          @default(1) @db.Decimal(10, 2)
  unit           String?
  priceCents     Int              @default(0)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  proposal       Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  section        ProposalSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([organizationId, proposalId])
  @@index([proposalId, sortOrder])
  @@index([sectionId])
}

