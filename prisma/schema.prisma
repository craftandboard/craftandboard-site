model OrgSettings {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  timezone             String
  currency             String
  defaultUnitSystem    UnitSystem   @default(IMPERIAL)
  bootstrapDefaultsJson Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  name           String?
  passwordHash   String?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation("UserDefaultOrganization", fields: [organizationId], references: [id])
  memberships    OrganizationMember[]
  sessions       Session[]
  activationTokens ActivationToken[]
  passwordResetTokens PasswordResetToken[]
  assignedProjectTasks ProjectTask[]
  costScenarios  CostScenario[]
  pricingScenarios PricingScenario[]
  shelfCostEstimates ShelfCostEstimate[]
  orderCostEstimates OrderCostEstimate[]
  manufacturingPackets ManufacturingPacket[]
  packetExpansionRuns PacketExpansionRun[]
  scanEvents           ScanEvent[]             @relation("ScanEventScannedByUser")
  labelRenderJobs      LabelRenderJob[]
  assignedContainerAssignments ContainerAssignment[] @relation("ContainerAssignmentAssignedByUser")
  unassignedContainerAssignments ContainerAssignment[] @relation("ContainerAssignmentUnassignedByUser")
  containerMoveEvents  ContainerMoveEvent[]    @relation("ContainerMoveEventMovedByUser")
  activeContainerSessionsStarted ActiveContainerSession[] @relation("ActiveContainerSessionStartedByUser")
  activeContainerSessionsEnded   ActiveContainerSession[] @relation("ActiveContainerSessionEndedByUser")
  remnantMoves        RemnantMovement[]        @relation("RemnantMovementMovedByUser")
  createdRemnantAllocations RemnantAllocation[] @relation("RemnantAllocationCreatedByUser")
  releasedRemnantAllocations RemnantAllocation[] @relation("RemnantAllocationReleasedByUser")
  assignedCraftBoardInquiries CraftBoardInquiry[] @relation("CraftBoardInquiryAssignedToUser")
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationMemberRole @default(OPERATOR)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id])
  organization   Organization           @relation(fields: [organizationId], references: [id])
  reviewedStageCandidateSignals StageCandidateSignal[] @relation("StageCandidateReviewedBy")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model PilotFeedback {
  id                String              @id @default(cuid())
  organizationId    String
  membershipId      String?
  area              PilotFeedbackArea
  severity          PilotFeedbackSeverity
  status            PilotFeedbackStatus @default(NEW)
  pagePath          String?
  title             String
  message           String
  reproductionNotes String?
  screenshotUrl     String?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, area])
  @@index([organizationId, severity])
  @@index([organizationId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  key            String?
  name           String
  address        String?
  status         String?
  stage          String?
  scopeSummary   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  leads          Lead[]
  proposals      Proposal[]
  proposalConversions ProposalConversion[]
  phases         ProjectPhase[]
  tasks          ProjectTask[]

  @@unique([organizationId, key])
  @@index([organizationId, updatedAt])
  @@index([organizationId, stage])
}

model ProjectPhase {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  status         String?
  summary        String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          ProjectTask[]

  @@unique([projectId, name])
  @@index([organizationId, projectId, sortOrder])
}

model ProjectTask {
  id               String       @id @default(cuid())
  organizationId   String
  projectId        String
  phaseId          String?
  title            String
  status           String       @default("OPEN")
  dueDate          DateTime?
  assignedToUserId String?
  isRequired       Boolean      @default(false)
  sortOrder        Int          @default(0)
  sourceKey        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id])
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase            ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assignedToUser   User?        @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
  @@index([projectId, phaseId, sortOrder])
  @@index([projectId, status])
  @@index([assignedToUserId, dueDate])
  @@unique([organizationId, projectId, sourceKey])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  name           String
  email          String?
  phone          String?
  address        String?
  status         String?
  stage          String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  proposals      Proposal[]
  proposalConversions ProposalConversion[]
  craftBoardInquiries CraftBoardInquiry[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, stage])
}

model CraftBoardInquiry {
  id             String                   @id @default(cuid())
  organizationId String
  leadId         String?
  assignedToUserId String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  status         CraftBoardInquiryStatus  @default(NEW)
  reviewedAt     DateTime?
  quotedAt       DateTime?
  source         String
  sourcePath     String?
  productFamily  String
  productSlug    String?
  productName    String
  customerName   String
  customerEmail  String
  customerPhone  String?
  widthValue     Decimal?
  widthUnit      String?
  depthValue     Decimal?
  depthUnit      String?
  thicknessValue Decimal?
  thicknessUnit  String?
  quantity       Int
  materialCode   String?
  materialLabel  String?
  mountingCode   String?
  mountingLabel  String?
  notes          String?
  configurationJson Json
  internalNotes  String?
  followUpNotes  String?
  reviewedWidthValue Decimal?
  reviewedDepthValue Decimal?
  reviewedThicknessValue Decimal?
  reviewedQuantity Int?
  reviewedMaterialCode String?
  reviewedMaterialLabel String?
  reviewedMountingCode String?
  reviewedMountingLabel String?
  estimateBaseAmountCents Int?
  estimateLowAmountCents Int?
  estimateHighAmountCents Int?
  estimateCurrencyCode String?
  estimateLeadTimeText String?
  estimateSummaryJson Json?
  quotePreparedBy String?
  quoteReferenceCode String?
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedToUser User?                    @relation("CraftBoardInquiryAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  craftBoardProposal  CraftBoardProposal?
  craftBoardOrders    CraftBoardOrder[]
  craftBoardProductionJobs CraftBoardProductionJob[]
  storefrontOrderAttempts CraftBoardStorefrontOrderAttempt[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, productFamily])
  @@index([organizationId, customerEmail])
  @@index([organizationId, reviewedAt])
  @@index([organizationId, quotedAt])
  @@index([assignedToUserId])
  @@index([leadId])
}

model CraftBoardProposal {
  id                    String                   @id @default(cuid())
  organizationId        String
  inquiryId             String                   @unique
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  status                CraftBoardProposalStatus @default(DRAFT)
  proposalNumber        String                   @unique
  title                 String
  customerNameSnapshot  String
  customerEmailSnapshot String
  customerPhoneSnapshot String?
  productFamily         String
  productName           String
  reviewedWidthValue    Decimal?
  reviewedDepthValue    Decimal?
  reviewedThicknessValue Decimal?
  reviewedQuantity      Int
  reviewedMaterialCode  String?
  reviewedMaterialLabel String?
  reviewedMountingCode  String?
  reviewedMountingLabel String?
  subtotalAmountCents   Int                      @default(0)
  discountAmountCents   Int                      @default(0)
  shippingAmountCents   Int                      @default(0)
  totalAmountCents      Int                      @default(0)
  currencyCode          String                   @default("USD")
  leadTimeText          String?
  scopeSummary          String
  inclusionsText        String?
  exclusionsText        String?
  notesForCustomer      String?
  internalNotes         String?
  publicToken           String                   @unique
  sharedAt              DateTime?
  customerViewedAt      DateTime?
  customerApprovedAt    DateTime?
  customerDeclinedAt    DateTime?
  expirationDate        DateTime?
  preparedBy            String?
  referenceCode         String?
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiry               CraftBoardInquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  lineItems             CraftBoardProposalLineItem[]
  craftBoardDepositRequests CraftBoardDepositRequest[]
  craftBoardOrder       CraftBoardOrder?
  craftBoardProductionJobs CraftBoardProductionJob[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, proposalNumber])
  @@index([publicToken])
}

model CraftBoardDepositRequest {
  id                       String                         @id @default(cuid())
  organizationId           String
