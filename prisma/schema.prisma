  @@index([organizationId, pricingPolicyId, createdAt])
  @@index([createdByUserId])
}

model SalesOrder {
  id                String              @id @default(cuid())
  organizationId    String
  sourceType        SalesOrderSourceType
  sourceOrderId     String?
  sourceStatus      String?
  customerName      String?
  customerEmail     String?
  shipToName        String?
  shipToAddressJson Json?
  orderedAt         DateTime?
  currency          String
  status            SalesOrderStatus    @default(DRAFT)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id])
  legacyOrder       Order?              @relation("LegacyOrderToSalesOrder")
  items             SalesOrderItem[]
  shelfJobs         ShelfJob[]
  manufacturingParts ManufacturingPart[]
  shelfCostEstimates ShelfCostEstimate[]
  costEstimates     OrderCostEstimate[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, sourceType, createdAt])
  @@index([organizationId, sourceOrderId])
}

model SalesOrderItem {
  id                    String                            @id @default(cuid())
  organizationId        String
  salesOrderId          String
  sourceLineId          String?
  shelfProductId        String?
  sku                   String?
  title                 String
  quantity              Int
  lengthIn              Decimal?                          @db.Decimal(8, 3)
  depthIn               Decimal?                          @db.Decimal(8, 3)
  thicknessIn           Decimal?                          @db.Decimal(8, 3)
  materialType          MaterialCode?
  edgeBandPattern       EdgeBandPattern?
  requiresPackaging     Boolean                           @default(true)
  packagingProfileId    String?
  customizationJson     Json?
  normalizedSpecJson    Json?
  normalizationStatus   SalesOrderItemNormalizationStatus @default(PENDING)
  normalizationErrorsJson Json?
  pricingStatus         SalesOrderItemPricingStatus       @default(PENDING)
  pricingSnapshotJson   Json?
  notes                 String?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  organization          Organization                      @relation(fields: [organizationId], references: [id])
  salesOrder            SalesOrder                        @relation(fields: [salesOrderId], references: [id])
  legacyOrderItem       OrderItem?                        @relation("LegacyOrderItemToSalesOrderItem")
  shelfProduct          ShelfProduct?                     @relation(fields: [shelfProductId], references: [id])
  packagingProfile      PackagingProfile?                 @relation(fields: [packagingProfileId], references: [id])
  shelfJobs             ShelfJob[]
  manufacturingParts    ManufacturingPart[]
  shelfCostEstimates    ShelfCostEstimate[]

  @@index([organizationId, salesOrderId, createdAt])
  @@index([organizationId, normalizationStatus, pricingStatus])
  @@index([organizationId, sourceLineId])
}

model ShelfJob {
  id                           String         @id @default(cuid())
  organizationId               String
  salesOrderId                 String
  salesOrderItemId             String         @unique
  manufacturingPacketId        String?
  shelfProductId               String?
  costProfileId                String
  productionAssumptionProfileId String
  packagingProfileId           String?
  pricingPolicyId              String
  pricingScenarioId            String?
  normalizedSpecJson           Json
  quantity                     Int
  jobStatus                    ShelfJobStatus @default(READY)
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  organization                 Organization   @relation(fields: [organizationId], references: [id])
  salesOrder                   SalesOrder     @relation(fields: [salesOrderId], references: [id])
  salesOrderItem               SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  legacyManufacturingJob       ManufacturingJob? @relation("LegacyManufacturingJobToShelfJob")
  manufacturingPacket          ManufacturingPacket? @relation(fields: [manufacturingPacketId], references: [id])
  shelfProduct                 ShelfProduct?  @relation(fields: [shelfProductId], references: [id])
  costProfile                  CostProfile    @relation(fields: [costProfileId], references: [id])
  productionAssumptionProfile  ProductionAssumptionProfile @relation(fields: [productionAssumptionProfileId], references: [id])
  packagingProfile             PackagingProfile? @relation(fields: [packagingProfileId], references: [id])
  pricingPolicy                PricingPolicy  @relation(fields: [pricingPolicyId], references: [id])
  pricingScenario              PricingScenario? @relation(fields: [pricingScenarioId], references: [id])
  manufacturingParts           ManufacturingPart[]
  costEstimates                ShelfCostEstimate[]

  @@index([organizationId, jobStatus, createdAt])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, manufacturingPacketId])
}

model ShelfCostEstimate {
  id                            String                       @id @default(cuid())
  organizationId                String
  shelfJobId                    String
  salesOrderId                  String
  salesOrderItemId              String
  costProfileId                 String
  productionAssumptionProfileId String
  packagingProfileId            String?
  pricingPolicyId               String
  estimateStatus                CostEstimateStatus           @default(COMPLETE)
  warningsJson                  Json?
  inputSnapshotJson             Json
  assumptionSnapshotJson        Json
  resultJson                    Json
  isCurrent                     Boolean                      @default(true)
  createdByUserId               String?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  organization                  Organization                 @relation(fields: [organizationId], references: [id])
  shelfJob                      ShelfJob                     @relation(fields: [shelfJobId], references: [id])
  salesOrder                    SalesOrder                   @relation(fields: [salesOrderId], references: [id])
  salesOrderItem                SalesOrderItem               @relation(fields: [salesOrderItemId], references: [id])
  costProfile                   CostProfile                  @relation(fields: [costProfileId], references: [id])
  productionAssumptionProfile   ProductionAssumptionProfile  @relation(fields: [productionAssumptionProfileId], references: [id])
  packagingProfile              PackagingProfile?            @relation(fields: [packagingProfileId], references: [id])
  pricingPolicy                 PricingPolicy                @relation(fields: [pricingPolicyId], references: [id])
  createdByUser                 User?                        @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, shelfJobId, createdAt])
  @@index([organizationId, salesOrderId, createdAt])
  @@index([organizationId, salesOrderItemId, createdAt])
  @@index([organizationId, isCurrent, createdAt])
}

model OrderCostEstimate {
  id                            String                       @id @default(cuid())
  organizationId                String
  salesOrderId                  String
  costProfileId                 String
  productionAssumptionProfileId String?
  packagingProfileId            String?
  pricingPolicyId               String?
  estimateStatus                CostEstimateStatus           @default(COMPLETE)
  warningsJson                  Json?
  inputSnapshotJson             Json
  assumptionSnapshotJson        Json
  resultJson                    Json
  isCurrent                     Boolean                      @default(true)
  createdByUserId               String?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  organization                  Organization                 @relation(fields: [organizationId], references: [id])
  salesOrder                    SalesOrder                   @relation(fields: [salesOrderId], references: [id])
  costProfile                   CostProfile                  @relation(fields: [costProfileId], references: [id])
  productionAssumptionProfile   ProductionAssumptionProfile? @relation(fields: [productionAssumptionProfileId], references: [id])
  packagingProfile              PackagingProfile?            @relation(fields: [packagingProfileId], references: [id])
  pricingPolicy                 PricingPolicy?               @relation(fields: [pricingPolicyId], references: [id])
  createdByUser                 User?                        @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, salesOrderId, createdAt])
  @@index([organizationId, isCurrent, createdAt])
}

model ManufacturingPacket {
  id              String                       @id @default(cuid())
  organizationId  String
  packetNumber    String
  sourceType      ManufacturingPacketSourceType
  sourceIdsJson   Json
  summaryJson     Json
  createdByUserId String?
  createdAt       DateTime                     @default(now())
  organization    Organization                 @relation(fields: [organizationId], references: [id])
  createdByUser   User?                        @relation(fields: [createdByUserId], references: [id])
  shelfJobs       ShelfJob[]
  parts           ManufacturingPart[]
  sourceRemnants  Remnant[]
  expansionRun    PacketExpansionRun?

  @@unique([organizationId, packetNumber])
  @@index([organizationId, createdAt])
  @@index([createdByUserId])
}

model ManufacturingPart {
  id                    String                   @id @default(cuid())
  organizationId        String
  manufacturingPacketId String
  shelfJobId            String
  salesOrderId          String
  salesOrderItemId      String
  batchId               String?
  currentContainerId    String?
  partNumber            String
  serialNumber          String?
  unitIndex             Int
  quantity              Int                      @default(1)
  partType              ManufacturingPartType    @default(SHELF)
  materialType          MaterialCode
  thicknessIn           Decimal                  @db.Decimal(8, 3)
  lengthIn              Decimal                  @db.Decimal(8, 3)
  depthIn               Decimal                  @db.Decimal(8, 3)
  edgeBandPattern       EdgeBandPattern
  requiresPackaging     Boolean                  @default(true)
  labelDataJson         Json
  status                ManufacturingPartStatus  @default(READY_FOR_BATCH)
  statusReason          String?
  sortGroup             String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  organization          Organization             @relation(fields: [organizationId], references: [id])
  manufacturingPacket   ManufacturingPacket      @relation(fields: [manufacturingPacketId], references: [id])
  shelfJob              ShelfJob                 @relation(fields: [shelfJobId], references: [id])
  legacyPart            Part?                    @relation("LegacyPartToManufacturingPart")
  salesOrder            SalesOrder               @relation(fields: [salesOrderId], references: [id])
  salesOrderItem        SalesOrderItem           @relation(fields: [salesOrderItemId], references: [id])
  batch                 ManufacturingBatch?      @relation(fields: [batchId], references: [id])
  currentContainer      Container?               @relation("CurrentContainerManufacturingParts", fields: [currentContainerId], references: [id])
  batchLinks            ManufacturingBatchPart[]
  scanEvents            ScanEvent[]
  labelRenderJobs       LabelRenderJob[]
  containerAssignments  ContainerAssignment[]
  sourceRemnants        Remnant[]
  linkedMachineEvents   MachineEvent[]

  @@unique([organizationId, partNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, manufacturingPacketId])
  @@index([organizationId, shelfJobId])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, salesOrderItemId])
  @@index([organizationId, batchId])
  @@index([organizationId, currentContainerId])
}

model ManufacturingBatch {
  id             String                   @id @default(cuid())
  organizationId String
  batchNumber    String
  batchType      ManufacturingBatchType
  materialType   MaterialCode?
  thicknessIn    Decimal?                 @db.Decimal(8, 3)
  status         ManufacturingBatchStatus @default(OPEN)
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id])
  legacyBatch    Batch?                   @relation("LegacyBatchToManufacturingBatch")
  parts          ManufacturingPart[]
  batchParts     ManufacturingBatchPart[]
  scanEvents     ScanEvent[]
  labelRenderJobs LabelRenderJob[]
  containers     Container[]
  linkedMachineEvents MachineEvent[]

  @@unique([organizationId, batchNumber])
  @@index([organizationId, batchType, status, createdAt])
}

model ManufacturingBatchPart {
  id                  String             @id @default(cuid())
  organizationId      String
  batchId             String
  manufacturingPartId String
  sequence            Int?
  createdAt           DateTime           @default(now())
  organization        Organization       @relation(fields: [organizationId], references: [id])
  batch               ManufacturingBatch @relation(fields: [batchId], references: [id])
  manufacturingPart   ManufacturingPart  @relation(fields: [manufacturingPartId], references: [id])

  @@unique([batchId, manufacturingPartId])
  @@index([organizationId, batchId, createdAt])
  @@index([organizationId, manufacturingPartId])
}

model LabelTemplateVersion {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  version        Int
  isDefault      Boolean      @default(false)
  templateJson   Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  labelRenderJobs LabelRenderJob[]

  @@unique([organizationId, code, version])
  @@index([organizationId, isDefault, createdAt])
}

model PacketExpansionRun {
  id                    String               @id @default(cuid())
  organizationId        String
  manufacturingPacketId String               @unique
  sourceJobCount        Int
  createdPartCount      Int
  resultJson            Json
  createdByUserId       String?
  createdAt             DateTime             @default(now())
  organization          Organization         @relation(fields: [organizationId], references: [id])
  manufacturingPacket   ManufacturingPacket  @relation(fields: [manufacturingPacketId], references: [id])
  createdByUser         User?                @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([createdByUserId])
}

model ContainerLocation {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  zone           String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  containers     Container[]
  moveEventsFrom ContainerMoveEvent[] @relation("ContainerMoveEventFromLocation")
  moveEventsTo   ContainerMoveEvent[] @relation("ContainerMoveEventToLocation")
  currentRemnants Remnant[] @relation("CurrentLocationRemnants")
  remnantMovementsFrom RemnantMovement[] @relation("RemnantMovementFromLocation")
  remnantMovementsTo   RemnantMovement[] @relation("RemnantMovementToLocation")
  machines       Machine[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model ContainerAssignment {
  id                   String            @id @default(cuid())
  organizationId       String
  containerId          String
  manufacturingPartId  String
  assignedAt           DateTime          @default(now())
  unassignedAt         DateTime?
  assignedByUserId     String?
  unassignedByUserId   String?
  assignmentReason     String?
  metadataJson         Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  organization         Organization      @relation(fields: [organizationId], references: [id])
  container            Container         @relation(fields: [containerId], references: [id])
  manufacturingPart    ManufacturingPart @relation(fields: [manufacturingPartId], references: [id])
  assignedByUser       User?             @relation("ContainerAssignmentAssignedByUser", fields: [assignedByUserId], references: [id])
  unassignedByUser     User?             @relation("ContainerAssignmentUnassignedByUser", fields: [unassignedByUserId], references: [id])

  @@index([organizationId, assignedAt])
  @@index([organizationId, containerId, unassignedAt])
  @@index([organizationId, manufacturingPartId, unassignedAt])
}

model ContainerMoveEvent {
  id             String             @id @default(cuid())
  organizationId String
  containerId    String
  fromLocationId String?
  toLocationId   String?
  movedByUserId  String?
  moveReason     String?
  metadataJson   Json?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id])
  container      Container          @relation(fields: [containerId], references: [id])
  fromLocation   ContainerLocation? @relation("ContainerMoveEventFromLocation", fields: [fromLocationId], references: [id])
  toLocation     ContainerLocation? @relation("ContainerMoveEventToLocation", fields: [toLocationId], references: [id])
  movedByUser    User?              @relation("ContainerMoveEventMovedByUser", fields: [movedByUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, containerId, createdAt])
}

model ActiveContainerSession {
  id              String                  @id @default(cuid())
  organizationId  String
  containerId     String
  stationType     ScanWorkflowStationType?
  startedByUserId String?
  endedByUserId   String?
  startedAt       DateTime                @default(now())
  endedAt         DateTime?
  isActive        Boolean                 @default(true)
  metadataJson    Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [organizationId], references: [id])
  container       Container               @relation(fields: [containerId], references: [id])
  startedByUser   User?                   @relation("ActiveContainerSessionStartedByUser", fields: [startedByUserId], references: [id])
  endedByUser     User?                   @relation("ActiveContainerSessionEndedByUser", fields: [endedByUserId], references: [id])

  @@index([organizationId, isActive, startedAt])
  @@index([organizationId, startedByUserId, isActive])
  @@index([organizationId, containerId, isActive])
}

model LabelRenderJob {
  id                   String            @id @default(cuid())
  organizationId       String
  entityType           ScanEntityType
  entityId             String
  manufacturingPartId  String?
  manufacturingBatchId String?
  remnantId            String?
  templateId           String?
  renderFormat         LabelRenderFormat
  payloadJson          Json
  outputHtml           String?
  outputPath           String?
  createdByUserId      String?
  createdAt            DateTime          @default(now())
  organization         Organization      @relation(fields: [organizationId], references: [id])
  manufacturingPart    ManufacturingPart? @relation(fields: [manufacturingPartId], references: [id])
  manufacturingBatch   ManufacturingBatch? @relation(fields: [manufacturingBatchId], references: [id])
  remnant             Remnant?          @relation(fields: [remnantId], references: [id])
  template             LabelTemplateVersion? @relation(fields: [templateId], references: [id])
  createdByUser        User?             @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([manufacturingPartId])
  @@index([manufacturingBatchId])
  @@index([remnantId])
  @@index([templateId])
  @@index([createdByUserId])
}

model WorkflowStationRule {
  id             String                   @id @default(cuid())
  organizationId String
  stationType    ScanWorkflowStationType
  entityType     ScanEntityType
  fromStatus     String
  actionType     ScanActionType
  toStatus       String
  isActive       Boolean                  @default(true)
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id])

  @@index([organizationId, stationType, entityType, isActive])
  @@unique([organizationId, stationType, entityType, fromStatus, actionType, toStatus])
}

model MachineProfile {
  id                  String       @id @default(cuid())
  organizationId      String
  code                String       @unique
  name                String
  controllerType      String
  fileExtension       String
  units               String
  toolDiameterIn      Decimal      @db.Decimal(8, 3)
  spindleRpm          Int
  feedRateIpm         Int
  plungeRateIpm       Int?
  cutDepthIn          Decimal      @db.Decimal(8, 3)
  onionSkinDepthIn    Decimal      @db.Decimal(8, 3)
  safeZIn             Decimal      @db.Decimal(8, 3)
  defaultCutStrategy  String
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id])
}

model MaterialProfile {
  id                     String           @id @default(cuid())
  organizationId         String
  code                   MaterialCode
  name                   String
  thicknessIn            Decimal          @db.Decimal(8, 3)
  sheetWidthIn           Decimal          @db.Decimal(8, 3)
  sheetDepthIn           Decimal          @db.Decimal(8, 3)
  trimMarginIn           Decimal          @db.Decimal(8, 3)
  defaultEdgeBandPattern EdgeBandPattern
  active                 Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  organization           Organization     @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
}
