generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MaterialCode {
  WHITE_MELAMINE
  MAPLE_MELAMINE
  BIRCH_18
  WALNUT_18
  MAPLE_18
  MDF_18
}

enum EdgeBandPattern {
  ALL_FOUR
}

enum OrderStatus {
  DRAFT
  IMPORTED
  READY_FOR_BATCH
  RECEIVED
  IN_PRODUCTION
  READY_FOR_SHIPMENT
  SHIPPED
  COMPLETE
  HOLD
  ERROR
}

enum PartStatus {
  PENDING
  READY_FOR_BATCH
  BATCHED
  CUT
  EDGEBANDED
  PACKED
  HOLD
  ERROR
}

enum BatchStatus {
  DRAFT
  PLANNED
  RELEASED
  CUTTING
  CUT_COMPLETE
  READY_FOR_NEXT_STAGE
  COMPLETE
}

enum ProductionBundleStatus {
  DRAFT
  READY_FOR_NESTING
  NESTED
  READY_FOR_CNC
  CNC_GENERATED
  APPROVED_FOR_PRODUCTION
  IN_PRODUCTION
  CUT_COMPLETE
  QC_HOLD
  PACKED
  SHIPPED
  ERROR
}

enum SheetStatus {
  PLANNED
  POSTED
  CUTTING
  CUT_COMPLETE
  QC_HOLD
  SCRAPPED
}

enum CncJobStatus {
  GENERATED
  APPROVED
  POSTED
  RAN
  FAILED
  SUPERSEDED
}

enum ArtifactType {
  SHEET_MAP_SVG
  SHEET_MAP_HTML
  CNC_FILE
  BUNDLE_PACKET_HTML
}

enum SalesChannel {
  AMAZON
  WEBSITE
  MANUAL
}

enum StationType {
  SCAN
  ASSEMBLY
  PACK
  SHIP
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  DELIVERED
}

enum JobSource {
  CONFIGURATOR
  AMAZON
}

enum ManufacturingJobStatus {
  DRAFT
  COMPLETE
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  OPERATOR
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]    @relation("UserDefaultOrganization")
  memberships OrganizationMember[]
  orders    Order[]
  orderItems OrderItem[]
  parts     Part[]
  batches   Batch[]
  bundles   ProductionBundle[]
  sheets    Sheet[]
  sheetPlacements SheetPlacement[]
  cncJobs   CncJob[]
  stations  Station[]
  scanEvents ScanEvent[]
  shipments Shipment[]
  artifacts Artifact[]
  machineProfiles  MachineProfile[]
  materialProfiles MaterialProfile[]
  manufacturingJobs ManufacturingJob[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  name           String?
  passwordHash   String?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation("UserDefaultOrganization", fields: [organizationId], references: [id])
  memberships    OrganizationMember[]
  sessions       Session[]
  activationTokens ActivationToken[]
  passwordResetTokens PasswordResetToken[]
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationMemberRole @default(OPERATOR)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id])
  organization   Organization           @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model ActivationToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model Order {
  id               String       @id @default(cuid())
  organizationId   String
  externalRef      String?
  externalOrderId  String?      @unique
  amazonOrderId    String?      @unique
  amazonOrderSource String?
  orderDate        DateTime?
  purchaseDate     DateTime?
  shipByDate       DateTime?
  customerName     String
  customerFullName String?
  shipToName       String?
  customerLastName String?
  status           OrderStatus  @default(DRAFT)
  channel          SalesChannel @default(MANUAL)
  rawPayload       Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id])
  items            OrderItem[]
  parts            Part[]
  shipments        Shipment[]
  artifacts        Artifact[]
  manufacturingJobs ManufacturingJob[]

  @@index([organizationId, shipByDate])
  @@index([customerLastName])
}

model OrderItem {
  id                    String          @id @default(cuid())
  organizationId        String?
  orderId               String
  externalOrderItemId   String?         @unique
  amazonOrderItemId     String?         @unique
  asin                  String?
  sku                   String
  title                 String
  productLabel          String
  normalizedLegacyXmlName String?
  quantity              Int             @default(1)
  materialCode          MaterialCode?
  edgeBandPattern       EdgeBandPattern @default(ALL_FOUR)
  widthIn               Decimal         @db.Decimal(8, 3)
  depthIn               Decimal         @db.Decimal(8, 3)
  thicknessIn           Decimal         @db.Decimal(8, 3)
  sourceLengthIn        Decimal?        @db.Decimal(8, 3)
  sourceDepthIn         Decimal?        @db.Decimal(8, 3)
  sourceEdgeBandText    String?
  sourceCustomizationJson Json?
  notes                 String?
  rawPayload            Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization?   @relation(fields: [organizationId], references: [id])
  order                 Order           @relation(fields: [orderId], references: [id])
  parts                 Part[]
  manufacturingJobs     ManufacturingJob[]

  @@index([orderId])
  @@index([organizationId])
}

model Part {
  id               String           @id @default(cuid())
  organizationId    String?
  orderItemId      String?
  batchId          String?
  orderId          String?
  manufacturingJobId String?
  scanCode         String           @unique
  name             String
  partCode         String           @unique
  qrPayload        String
  serialNumber     Int?
  instanceNumber   Int              @default(1)
  materialCode     MaterialCode?
  edgeBandPattern  EdgeBandPattern  @default(ALL_FOUR)
  widthIn          Decimal          @db.Decimal(8, 3)
  depthIn          Decimal          @db.Decimal(8, 3)
  thicknessIn      Decimal          @db.Decimal(8, 3)
  shipByDate       DateTime?
  customerLastName String?
  status           PartStatus       @default(READY_FOR_BATCH)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  order            Order?           @relation(fields: [orderId], references: [id])
  orderItem        OrderItem?       @relation(fields: [orderItemId], references: [id])
  batch            Batch?           @relation(fields: [batchId], references: [id])
  manufacturingJob ManufacturingJob? @relation(fields: [manufacturingJobId], references: [id])
  placements       SheetPlacement[]

  @@index([shipByDate, materialCode])
  @@index([orderItemId])
  @@index([customerLastName])
  @@index([organizationId])
}

model ManufacturingJob {
  id                String                 @id @default(cuid())
  organizationId    String
  orderId           String?
  orderItemId       String?
  batchId           String?
  source            JobSource              @default(CONFIGURATOR)
  status            ManufacturingJobStatus @default(DRAFT)
  channel           SalesChannel
  partType          String
  materialCode      MaterialCode
  edgeBandPattern   EdgeBandPattern        @default(ALL_FOUR)
  widthIn           Decimal                @db.Decimal(8, 3)
  depthIn           Decimal                @db.Decimal(8, 3)
  thicknessIn       Decimal                @db.Decimal(8, 3)
  quantity          Int
  unit              String                 @default("IN")
  manufacturingMode String
  labelCode         String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  organization      Organization           @relation(fields: [organizationId], references: [id])
  order             Order?                 @relation(fields: [orderId], references: [id])
  orderItem         OrderItem?             @relation(fields: [orderItemId], references: [id])
  batch             Batch?                 @relation(fields: [batchId], references: [id])
  parts             Part[]

  @@index([organizationId, status])
  @@index([materialCode, channel])
}

model Batch {
  id             String       @id @default(cuid())
  organizationId String
  code           String       @unique
  name           String
  status         BatchStatus  @default(DRAFT)
  materialCode   MaterialCode
  source         JobSource    @default(CONFIGURATOR)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  parts          Part[]
  manufacturingJobs ManufacturingJob[]
  sheets         Sheet[]
  cncJobs        CncJob[]
  artifacts      Artifact[]
}

model ProductionBundle {
  id                    String                 @id @default(cuid())
  organizationId        String
  code                  String                 @unique
  shipByDate            DateTime
  materialCode          MaterialCode
  status                ProductionBundleStatus @default(DRAFT)
  releasedAt            DateTime?
  releasedBy            String?
  nestingApprovedAt     DateTime?
  nestingApprovedBy     String?
  cncApprovedAt         DateTime?
  cncApprovedBy         String?
  currentNestVersion    Int?
  currentCncVersion     Int?
  totalLineItems        Int                    @default(0)
  totalPhysicalParts    Int                    @default(0)
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id])
  sheets                Sheet[]
  cncJobs               CncJob[]
  artifacts             Artifact[]

  @@index([organizationId, shipByDate])
  @@index([status, materialCode])
}

model Sheet {
  id                   String           @id @default(cuid())
  organizationId       String?
  batchId              String?
  productionBundleId   String?
  productionBundleCode String?
  materialCode         MaterialCode
  sheetNumber          Int
  version              Int              @default(1)
  widthMm              Int
  heightMm             Int
  widthIn              Decimal          @db.Decimal(8, 3)
  heightIn             Decimal          @db.Decimal(8, 3)
  usableXIn            Decimal          @db.Decimal(8, 3)
  usableYIn            Decimal          @db.Decimal(8, 3)
  usableWidthIn        Decimal          @db.Decimal(8, 3)
  usableHeightIn       Decimal          @db.Decimal(8, 3)
  utilizationPct       Decimal          @db.Decimal(6, 3)
  status               SheetStatus      @default(PLANNED)
  isCurrent            Boolean          @default(true)
  approvedAt           DateTime?
  postedAt             DateTime?
  completedAt          DateTime?
  scrapReason          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organization         Organization?    @relation(fields: [organizationId], references: [id])
  batch                Batch?           @relation(fields: [batchId], references: [id])
  productionBundle     ProductionBundle? @relation(fields: [productionBundleId], references: [id])
  placements           SheetPlacement[]
  artifacts            Artifact[]
  cncJobs              CncJob[]

  @@index([productionBundleId, version])
  @@index([productionBundleCode, materialCode])
  @@index([organizationId])
}

model SheetPlacement {
  id             String   @id @default(cuid())
  organizationId String?
  sheetId        String
  partId         String
  xMm            Int
  yMm            Int
  xIn            Decimal  @db.Decimal(8, 3)
  yIn            Decimal  @db.Decimal(8, 3)
  widthIn        Decimal  @db.Decimal(8, 3)
  depthIn        Decimal  @db.Decimal(8, 3)
  rotation       Int      @default(0)
  rotationDeg    Int      @default(0)
  sequenceNumber Int      @default(1)
  onionSkin      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  sheet          Sheet    @relation(fields: [sheetId], references: [id])
  part           Part     @relation(fields: [partId], references: [id])

  @@index([organizationId])
}

model CncJob {
  id                   String        @id @default(cuid())
  organizationId       String?
  batchId              String?
  productionBundleId   String?
  productionBundleCode String?
  sheetId              String?
  code                 String        @unique
  materialCode         MaterialCode
  controllerType       String
  fileExtension        String
  version              Int           @default(1)
  status               CncJobStatus  @default(GENERATED)
  isCurrent            Boolean       @default(true)
  toolDiameterIn       Decimal       @db.Decimal(8, 3)
  spindleRpm           Int
  feedRateIpm          Int
  plungeRateIpm        Int
  approvedAt           DateTime?
  approvedBy           String?
  postedAt             DateTime?
  ranAt                DateTime?
  supersededAt         DateTime?
  failureReason        String?
  machineCode          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  organization         Organization? @relation(fields: [organizationId], references: [id])
  batch                Batch?        @relation(fields: [batchId], references: [id])
  productionBundle     ProductionBundle? @relation(fields: [productionBundleId], references: [id])
  sheet                Sheet?        @relation(fields: [sheetId], references: [id])
  artifacts            Artifact[]

  @@index([productionBundleId, version])
  @@index([productionBundleCode, materialCode])
  @@index([organizationId])
}

model Station {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           StationType
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  scanEvents     ScanEvent[]
}

model ScanEvent {
  id        String   @id @default(cuid())
  organizationId String?
  stationId String
  code      String
  createdAt DateTime @default(now())
  organization Organization? @relation(fields: [organizationId], references: [id])
  station   Station  @relation(fields: [stationId], references: [id])

  @@index([organizationId])
}

model Shipment {
  id          String          @id @default(cuid())
  organizationId String?
  orderId     String
  carrierCode String?
  trackingNo  String?
  status      ShipmentStatus  @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  organization Organization?  @relation(fields: [organizationId], references: [id])
  order       Order           @relation(fields: [orderId], references: [id])
  artifacts   Artifact[]

  @@index([organizationId])
}

model Artifact {
  id         String       @id @default(cuid())
  organizationId String?
  type       String
  artifactType ArtifactType?
  uri        String
  mimeType   String?
  version    Int          @default(1)
  isCurrent  Boolean      @default(true)
  supersededAt DateTime?
  generatedFrom String?
  orderId    String?
  batchId    String?
  productionBundleId String?
  productionBundleCode String?
  sheetId    String?
  cncJobId   String?
  shipmentId String?
  createdAt  DateTime  @default(now())
  organization Organization? @relation(fields: [organizationId], references: [id])
  order      Order?    @relation(fields: [orderId], references: [id])
  batch      Batch?    @relation(fields: [batchId], references: [id])
  productionBundle ProductionBundle? @relation(fields: [productionBundleId], references: [id])
  sheet      Sheet?    @relation(fields: [sheetId], references: [id])
  cncJob     CncJob?   @relation(fields: [cncJobId], references: [id])
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])

  @@index([organizationId])
}

model MachineProfile {
  id                  String       @id @default(cuid())
  organizationId      String
  code                String       @unique
  name                String
  controllerType      String
  fileExtension       String
  units               String
  toolDiameterIn      Decimal      @db.Decimal(8, 3)
  spindleRpm          Int
  feedRateIpm         Int
  plungeRateIpm       Int?
  cutDepthIn          Decimal      @db.Decimal(8, 3)
  onionSkinDepthIn    Decimal      @db.Decimal(8, 3)
  safeZIn             Decimal      @db.Decimal(8, 3)
  defaultCutStrategy  String
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id])
}

model MaterialProfile {
  id                     String           @id @default(cuid())
  organizationId         String
  code                   MaterialCode
  name                   String
  thicknessIn            Decimal          @db.Decimal(8, 3)
  sheetWidthIn           Decimal          @db.Decimal(8, 3)
  sheetDepthIn           Decimal          @db.Decimal(8, 3)
  trimMarginIn           Decimal          @db.Decimal(8, 3)
  defaultEdgeBandPattern EdgeBandPattern
  active                 Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  organization           Organization     @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
}
