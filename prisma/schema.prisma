generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MaterialCode {
  WHITE_MELAMINE
  MAPLE_MELAMINE
  BIRCH_18
  WALNUT_18
  MAPLE_18
  MDF_18
}

enum EdgeBandPattern {
  ALL_FOUR
}

enum OrderStatus {
  DRAFT
  IMPORTED
  READY_FOR_BATCH
  RECEIVED
  IN_PRODUCTION
  READY_FOR_SHIPMENT
  SHIPPED
  COMPLETE
  HOLD
  ERROR
}

enum PartStatus {
  PENDING
  READY_FOR_BATCH
  BATCHED
  CUT
  EDGEBANDED
  PACKED
  HOLD
  ERROR
}

enum BatchStatus {
  DRAFT
  PLANNED
  RELEASED
  CUTTING
  CUT_COMPLETE
  READY_FOR_NEXT_STAGE
  COMPLETE
}

enum ProductionBundleStatus {
  DRAFT
  READY_FOR_NESTING
  NESTED
  READY_FOR_CNC
  CNC_GENERATED
  APPROVED_FOR_PRODUCTION
  IN_PRODUCTION
  CUT_COMPLETE
  QC_HOLD
  PACKED
  SHIPPED
  ERROR
}

enum SheetStatus {
  PLANNED
  POSTED
  CUTTING
  CUT_COMPLETE
  QC_HOLD
  SCRAPPED
}

enum CncJobStatus {
  GENERATED
  APPROVED
  POSTED
  RAN
  FAILED
  SUPERSEDED
}

enum ArtifactType {
  SHEET_MAP_SVG
  SHEET_MAP_HTML
  CNC_FILE
  BUNDLE_PACKET_HTML
}

enum SalesChannel {
  AMAZON
  WEBSITE
  MANUAL
}

enum StationType {
  SCAN
  ASSEMBLY
  PACK
  SHIP
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  DELIVERED
}

enum JobSource {
  CONFIGURATOR
  AMAZON
}

enum ManufacturingJobStatus {
  DRAFT
  COMPLETE
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  OPERATOR
}

enum ContainerType {
  CONTAINER
  BIN
}

enum ContainerStatus {
  OPEN
  SORTING
  COMPLETE
  HOLD
  CLOSED
}

enum RemnantStatus {
  AVAILABLE
  RESERVED
  PARTIAL
  CONSUMED
  HOLD
  SCRAPPED
}

enum RemnantSourceType {
  FULL_SHEET_LEFTOVER
  MANUAL
  IMPORTED
}

enum RemnantUsageActionType {
  CREATED
  RESERVED
  CONSUMED
  PARTIAL_CONSUME
  RELEASED
  SCRAPPED
  HOLD
  UPDATED
}

enum MachineType {
  CNC
  EDGEBANDER
  LABEL_PRINTER
  SCANNER_STATION
  OTHER
}

enum MachineStatus {
  ACTIVE
  INACTIVE
  HOLD
  MAINTENANCE
}

enum MachineEventSourceType {
  MANUAL_SIMULATION
  API
  FILE_IMPORT
  PLC_BRIDGE
  WEBHOOK
  OTHER
}

enum MachineEventProcessingStatus {
  RECEIVED
  PARSED
  LINKED
  UNMATCHED
  ERROR
}

enum StageCandidateTargetType {
  PART
  BATCH
  MANUFACTURING_JOB
}

enum StageCandidateStatus {
  OPEN
  APPLIED
  REJECTED
  SUPERSEDED
}

enum StageCandidateAction {
  MARK_PART_CUT
  MARK_PART_EDGEBANDED
  MARK_BATCH_CUT_IN_PROGRESS
  MARK_BATCH_CUT_COMPLETE
  MARK_JOB_EDGE_IN_PROGRESS
  MARK_JOB_EDGE_COMPLETE
}

enum StageCandidateConfidence {
  HIGH
  MEDIUM
}

enum StageCandidateAppliedMode {
  MANUAL
  AUTO
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]    @relation("UserDefaultOrganization")
  memberships OrganizationMember[]
  orders    Order[]
  orderItems OrderItem[]
  parts     Part[]
  batches   Batch[]
  bundles   ProductionBundle[]
  sheets    Sheet[]
  sheetPlacements SheetPlacement[]
  cncJobs   CncJob[]
  stations  Station[]
  scanEvents ScanEvent[]
  shipments Shipment[]
  artifacts Artifact[]
  machineProfiles  MachineProfile[]
  materialProfiles MaterialProfile[]
  manufacturingJobs ManufacturingJob[]
  containers Container[]
  partContainerAssignments PartContainerAssignment[]
  remnants Remnant[]
  remnantUsages RemnantUsage[]
  machines  Machine[]
  machineEvents MachineEvent[]
  stageCandidateSignals StageCandidateSignal[]
  trustedAutoApplyRules TrustedAutoApplyRule[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  name           String?
  passwordHash   String?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation("UserDefaultOrganization", fields: [organizationId], references: [id])
  memberships    OrganizationMember[]
  sessions       Session[]
  activationTokens ActivationToken[]
  passwordResetTokens PasswordResetToken[]
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationMemberRole @default(OPERATOR)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id])
  organization   Organization           @relation(fields: [organizationId], references: [id])
  reviewedStageCandidateSignals StageCandidateSignal[] @relation("StageCandidateReviewedBy")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model ActivationToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model Order {
  id               String       @id @default(cuid())
  organizationId   String
  externalRef      String?
  externalOrderId  String?      @unique
  amazonOrderId    String?      @unique
  amazonOrderSource String?
  orderDate        DateTime?
  purchaseDate     DateTime?
  shipByDate       DateTime?
  customerName     String
  customerFullName String?
  shipToName       String?
  customerLastName String?
  status           OrderStatus  @default(DRAFT)
  channel          SalesChannel @default(MANUAL)
  rawPayload       Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id])
  items            OrderItem[]
  parts            Part[]
  shipments        Shipment[]
  artifacts        Artifact[]
  manufacturingJobs ManufacturingJob[]
  containers       Container[]

  @@index([organizationId, shipByDate])
  @@index([customerLastName])
}

model OrderItem {
  id                    String          @id @default(cuid())
  organizationId        String?
  orderId               String
  externalOrderItemId   String?         @unique
  amazonOrderItemId     String?         @unique
  asin                  String?
  sku                   String
  title                 String
  productLabel          String
  normalizedLegacyXmlName String?
  quantity              Int             @default(1)
  materialCode          MaterialCode?
  edgeBandPattern       EdgeBandPattern @default(ALL_FOUR)
  widthIn               Decimal         @db.Decimal(8, 3)
  depthIn               Decimal         @db.Decimal(8, 3)
  thicknessIn           Decimal         @db.Decimal(8, 3)
  sourceLengthIn        Decimal?        @db.Decimal(8, 3)
  sourceDepthIn         Decimal?        @db.Decimal(8, 3)
  sourceEdgeBandText    String?
  sourceCustomizationJson Json?
  notes                 String?
  rawPayload            Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization?   @relation(fields: [organizationId], references: [id])
  order                 Order           @relation(fields: [orderId], references: [id])
  parts                 Part[]
  manufacturingJobs     ManufacturingJob[]

  @@index([orderId])
  @@index([organizationId])
}

model Part {
  id               String           @id @default(cuid())
  organizationId    String?
  orderItemId      String?
  batchId          String?
  currentContainerId String?
  orderId          String?
  manufacturingJobId String?
  scanCode         String           @unique
  name             String
  partCode         String           @unique
  qrPayload        String
  serialNumber     Int?
  instanceNumber   Int              @default(1)
  materialCode     MaterialCode?
  edgeBandPattern  EdgeBandPattern  @default(ALL_FOUR)
  widthIn          Decimal          @db.Decimal(8, 3)
  depthIn          Decimal          @db.Decimal(8, 3)
  thicknessIn      Decimal          @db.Decimal(8, 3)
  shipByDate       DateTime?
  customerLastName String?
  status           PartStatus       @default(READY_FOR_BATCH)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  order            Order?           @relation(fields: [orderId], references: [id])
  orderItem        OrderItem?       @relation(fields: [orderItemId], references: [id])
  batch            Batch?           @relation(fields: [batchId], references: [id])
  currentContainer Container?       @relation("CurrentContainerParts", fields: [currentContainerId], references: [id])
  manufacturingJob ManufacturingJob? @relation(fields: [manufacturingJobId], references: [id])
  placements       SheetPlacement[]
  containerAssignments PartContainerAssignment[]
  remnantUsages RemnantUsage[]
  machineEvents   MachineEvent[]
  stageCandidateSignals StageCandidateSignal[]

  @@index([shipByDate, materialCode])
  @@index([orderItemId])
  @@index([customerLastName])
  @@index([organizationId])
  @@index([currentContainerId])
}

model ManufacturingJob {
  id                String                 @id @default(cuid())
  organizationId    String
  orderId           String?
  orderItemId       String?
  batchId           String?
  source            JobSource              @default(CONFIGURATOR)
  status            ManufacturingJobStatus @default(DRAFT)
  channel           SalesChannel
  partType          String
  materialCode      MaterialCode
  edgeBandPattern   EdgeBandPattern        @default(ALL_FOUR)
  widthIn           Decimal                @db.Decimal(8, 3)
  depthIn           Decimal                @db.Decimal(8, 3)
  thicknessIn       Decimal                @db.Decimal(8, 3)
  quantity          Int
  unit              String                 @default("IN")
  manufacturingMode String
  labelCode         String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  organization      Organization           @relation(fields: [organizationId], references: [id])
  order             Order?                 @relation(fields: [orderId], references: [id])
  orderItem         OrderItem?             @relation(fields: [orderItemId], references: [id])
  batch             Batch?                 @relation(fields: [batchId], references: [id])
  parts             Part[]
  containers        Container[]
  machineEvents     MachineEvent[]
  stageCandidateSignals StageCandidateSignal[]

  @@index([organizationId, status])
  @@index([materialCode, channel])
}

model Batch {
  id             String       @id @default(cuid())
  organizationId String
  code           String       @unique
  name           String
  status         BatchStatus  @default(DRAFT)
  materialCode   MaterialCode
  source         JobSource    @default(CONFIGURATOR)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  parts          Part[]
  manufacturingJobs ManufacturingJob[]
  sheets         Sheet[]
  cncJobs        CncJob[]
  artifacts      Artifact[]
  containers     Container[]
  sourceRemnants Remnant[]      @relation("SourceBatchRemnants")
  remnantUsages  RemnantUsage[] @relation("BatchRemnantUsages")
  machineEvents  MachineEvent[]
  stageCandidateSignals StageCandidateSignal[]
}

model Container {
  id                 String            @id @default(cuid())
  organizationId     String
  batchId            String
  orderId            String?
  manufacturingJobId String?
  code               String
  label              String
  type               ContainerType
  status             ContainerStatus   @default(OPEN)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization      @relation(fields: [organizationId], references: [id])
  batch              Batch             @relation(fields: [batchId], references: [id])
  order              Order?            @relation(fields: [orderId], references: [id])
  manufacturingJob   ManufacturingJob? @relation(fields: [manufacturingJobId], references: [id])
  currentParts       Part[]            @relation("CurrentContainerParts")
  assignments        PartContainerAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId, batchId, status])
}

model PartContainerAssignment {
  id             String       @id @default(cuid())
  organizationId String
  partId         String
  containerId    String
  assignedAt     DateTime     @default(now())
  removedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  part           Part         @relation(fields: [partId], references: [id])
  container      Container    @relation(fields: [containerId], references: [id])

  @@index([organizationId, assignedAt])
  @@index([partId, removedAt])
  @@index([containerId, removedAt])
}

model Remnant {
  id              String            @id @default(cuid())
  organizationId  String
  code            String
  materialKey     String
  materialCode    MaterialCode
  materialLabel   String
  thicknessIn     Decimal           @db.Decimal(8, 3)
  edgeBandPattern EdgeBandPattern   @default(ALL_FOUR)
  lengthIn        Decimal           @db.Decimal(8, 3)
  widthIn         Decimal           @db.Decimal(8, 3)
  areaSqIn        Decimal           @db.Decimal(10, 3)
  usableAreaSqIn  Decimal?          @db.Decimal(10, 3)
  sourceBatchId   String?
  sourceType      RemnantSourceType @default(MANUAL)
  status          RemnantStatus     @default(AVAILABLE)
  locationLabel   String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id])
  sourceBatch     Batch?            @relation("SourceBatchRemnants", fields: [sourceBatchId], references: [id])
  usages          RemnantUsage[]
  artifacts       Artifact[]

  @@unique([organizationId, code])
  @@index([organizationId, materialKey, status])
  @@index([organizationId, locationLabel])
}

model RemnantUsage {
  id               String                 @id @default(cuid())
  organizationId   String
  remnantId        String
  batchId          String?
  partId           String?
  actionType       RemnantUsageActionType
  usedAreaSqIn     Decimal?               @db.Decimal(10, 3)
  previousLengthIn Decimal?               @db.Decimal(8, 3)
  previousWidthIn  Decimal?               @db.Decimal(8, 3)
  newLengthIn      Decimal?               @db.Decimal(8, 3)
  newWidthIn       Decimal?               @db.Decimal(8, 3)
  notes            String?
  createdAt        DateTime               @default(now())
  organization     Organization           @relation(fields: [organizationId], references: [id])
  remnant          Remnant                @relation(fields: [remnantId], references: [id])
  batch            Batch?                 @relation("BatchRemnantUsages", fields: [batchId], references: [id])
  part             Part?                  @relation(fields: [partId], references: [id])

  @@index([organizationId, createdAt])
  @@index([remnantId, createdAt])
  @@index([batchId, createdAt])
  @@index([partId, createdAt])
}

model ProductionBundle {
  id                    String                 @id @default(cuid())
  organizationId        String
  code                  String                 @unique
  shipByDate            DateTime
  materialCode          MaterialCode
  status                ProductionBundleStatus @default(DRAFT)
  releasedAt            DateTime?
  releasedBy            String?
  nestingApprovedAt     DateTime?
  nestingApprovedBy     String?
  cncApprovedAt         DateTime?
  cncApprovedBy         String?
  currentNestVersion    Int?
  currentCncVersion     Int?
  totalLineItems        Int                    @default(0)
  totalPhysicalParts    Int                    @default(0)
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id])
  sheets                Sheet[]
  cncJobs               CncJob[]
  artifacts             Artifact[]

  @@index([organizationId, shipByDate])
  @@index([status, materialCode])
}

model Sheet {
  id                   String           @id @default(cuid())
  organizationId       String?
  batchId              String?
  productionBundleId   String?
  productionBundleCode String?
  materialCode         MaterialCode
  sheetNumber          Int
  version              Int              @default(1)
  widthMm              Int
  heightMm             Int
  widthIn              Decimal          @db.Decimal(8, 3)
  heightIn             Decimal          @db.Decimal(8, 3)
  usableXIn            Decimal          @db.Decimal(8, 3)
  usableYIn            Decimal          @db.Decimal(8, 3)
  usableWidthIn        Decimal          @db.Decimal(8, 3)
  usableHeightIn       Decimal          @db.Decimal(8, 3)
  utilizationPct       Decimal          @db.Decimal(6, 3)
  status               SheetStatus      @default(PLANNED)
  isCurrent            Boolean          @default(true)
  approvedAt           DateTime?
  postedAt             DateTime?
  completedAt          DateTime?
  scrapReason          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organization         Organization?    @relation(fields: [organizationId], references: [id])
  batch                Batch?           @relation(fields: [batchId], references: [id])
  productionBundle     ProductionBundle? @relation(fields: [productionBundleId], references: [id])
  placements           SheetPlacement[]
  artifacts            Artifact[]
  cncJobs              CncJob[]

  @@index([productionBundleId, version])
  @@index([productionBundleCode, materialCode])
  @@index([organizationId])
}

model SheetPlacement {
  id             String   @id @default(cuid())
  organizationId String?
  sheetId        String
  partId         String
  xMm            Int
  yMm            Int
  xIn            Decimal  @db.Decimal(8, 3)
  yIn            Decimal  @db.Decimal(8, 3)
  widthIn        Decimal  @db.Decimal(8, 3)
  depthIn        Decimal  @db.Decimal(8, 3)
  rotation       Int      @default(0)
  rotationDeg    Int      @default(0)
  sequenceNumber Int      @default(1)
  onionSkin      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  sheet          Sheet    @relation(fields: [sheetId], references: [id])
  part           Part     @relation(fields: [partId], references: [id])

  @@index([organizationId])
}

model CncJob {
  id                   String        @id @default(cuid())
  organizationId       String?
  batchId              String?
  productionBundleId   String?
  productionBundleCode String?
  sheetId              String?
  code                 String        @unique
  materialCode         MaterialCode
  controllerType       String
  fileExtension        String
  version              Int           @default(1)
  status               CncJobStatus  @default(GENERATED)
  isCurrent            Boolean       @default(true)
  toolDiameterIn       Decimal       @db.Decimal(8, 3)
  spindleRpm           Int
  feedRateIpm          Int
  plungeRateIpm        Int
  approvedAt           DateTime?
  approvedBy           String?
  postedAt             DateTime?
  ranAt                DateTime?
  supersededAt         DateTime?
  failureReason        String?
  machineCode          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  organization         Organization? @relation(fields: [organizationId], references: [id])
  batch                Batch?        @relation(fields: [batchId], references: [id])
  productionBundle     ProductionBundle? @relation(fields: [productionBundleId], references: [id])
  sheet                Sheet?        @relation(fields: [sheetId], references: [id])
  artifacts            Artifact[]

  @@index([productionBundleId, version])
  @@index([productionBundleCode, materialCode])
  @@index([organizationId])
}

model Station {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           StationType
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  scanEvents     ScanEvent[]
}

model ScanEvent {
  id        String   @id @default(cuid())
  organizationId String?
  stationId String
  code      String
  createdAt DateTime @default(now())
  organization Organization? @relation(fields: [organizationId], references: [id])
  station   Station  @relation(fields: [stationId], references: [id])

  @@index([organizationId])
}

model Shipment {
  id          String          @id @default(cuid())
  organizationId String?
  orderId     String
  carrierCode String?
  trackingNo  String?
  status      ShipmentStatus  @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  organization Organization?  @relation(fields: [organizationId], references: [id])
  order       Order           @relation(fields: [orderId], references: [id])
  artifacts   Artifact[]

  @@index([organizationId])
}

model Artifact {
  id         String       @id @default(cuid())
  organizationId String?
  type       String
  artifactType ArtifactType?
  uri        String
  mimeType   String?
  version    Int          @default(1)
  isCurrent  Boolean      @default(true)
  supersededAt DateTime?
  generatedFrom String?
  orderId    String?
  batchId    String?
  productionBundleId String?
  productionBundleCode String?
  sheetId    String?
  cncJobId   String?
  shipmentId String?
  remnantId  String?
  createdAt  DateTime  @default(now())
  organization Organization? @relation(fields: [organizationId], references: [id])
  order      Order?    @relation(fields: [orderId], references: [id])
  batch      Batch?    @relation(fields: [batchId], references: [id])
  productionBundle ProductionBundle? @relation(fields: [productionBundleId], references: [id])
  sheet      Sheet?    @relation(fields: [sheetId], references: [id])
  cncJob     CncJob?   @relation(fields: [cncJobId], references: [id])
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  remnant    Remnant?  @relation(fields: [remnantId], references: [id])

  @@index([organizationId])
}

model Machine {
  id             String        @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           MachineType
  status         MachineStatus @default(ACTIVE)
  locationLabel  String?
  adapterType    String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  events         MachineEvent[]
  stageCandidateSignals StageCandidateSignal[]
  trustedAutoApplyRules TrustedAutoApplyRule[]

  @@unique([organizationId, code])
  @@index([organizationId, type, status])
}

model MachineEvent {
  id                       String                       @id @default(cuid())
  organizationId           String
  machineId                String
  eventType                String
  eventTs                  DateTime
  sourceType               MachineEventSourceType
  sourceEventId            String?
  payloadJson              Json
  normalizedBatchRef       String?
  normalizedJobRef         String?
  normalizedPartRef        String?
  sheetRef                 String?
  severity                 String?
  processingStatus         MachineEventProcessingStatus @default(RECEIVED)
  linkedBatchId            String?
  linkedManufacturingJobId String?
  linkedPartId             String?
  notes                    String?
  createdAt                DateTime                     @default(now())
  organization             Organization                 @relation(fields: [organizationId], references: [id])
  machine                  Machine                      @relation(fields: [machineId], references: [id])
  linkedBatch              Batch?                       @relation(fields: [linkedBatchId], references: [id])
  linkedManufacturingJob   ManufacturingJob?            @relation(fields: [linkedManufacturingJobId], references: [id])
  linkedPart               Part?                        @relation(fields: [linkedPartId], references: [id])
  stageCandidateSignals    StageCandidateSignal[]

  @@index([organizationId, machineId, createdAt])
  @@index([organizationId, processingStatus, createdAt])
  @@index([organizationId, eventType, createdAt])
  @@index([linkedBatchId])
  @@index([linkedManufacturingJobId])
  @@index([linkedPartId])
}

model StageCandidateSignal {
  id                       String                   @id @default(cuid())
  organizationId           String
  sourceMachineEventId     String
  sourceMachineId          String
  targetType               StageCandidateTargetType
  targetPartId             String?
  targetBatchId            String?
  targetManufacturingJobId String?
  candidateStage           String
  currentStage             String?
  recommendedAction        StageCandidateAction
  confidence               StageCandidateConfidence
  rationale                String
  status                   StageCandidateStatus     @default(OPEN)
  appliedMode              StageCandidateAppliedMode?
  autoAppliedByRuleId      String?
  autoAppliedAt            DateTime?
  autoApplyRationale       String?
  reviewedByMemberId       String?
  reviewedAt               DateTime?
  appliedAt                DateTime?
  rejectedAt               DateTime?
  rejectionReason          String?
  notes                    String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  organization             Organization             @relation(fields: [organizationId], references: [id])
  sourceMachineEvent       MachineEvent             @relation(fields: [sourceMachineEventId], references: [id])
  sourceMachine            Machine                  @relation(fields: [sourceMachineId], references: [id])
  targetPart               Part?                    @relation(fields: [targetPartId], references: [id])
  targetBatch              Batch?                   @relation(fields: [targetBatchId], references: [id])
  targetManufacturingJob   ManufacturingJob?        @relation(fields: [targetManufacturingJobId], references: [id])
  reviewedByMember         OrganizationMember?      @relation("StageCandidateReviewedBy", fields: [reviewedByMemberId], references: [id])
  autoAppliedByRule        TrustedAutoApplyRule?    @relation(fields: [autoAppliedByRuleId], references: [id])

  @@index([organizationId, status, createdAt])
  @@index([sourceMachineEventId])
  @@index([sourceMachineId])
  @@index([targetBatchId])
  @@index([targetManufacturingJobId])
  @@index([targetPartId])
  @@unique([sourceMachineEventId, recommendedAction, targetType, targetBatchId, targetManufacturingJobId, targetPartId])
}

model TrustedAutoApplyRule {
  id                String               @id @default(cuid())
  organizationId    String
  machineId         String?
  machineType       MachineType?
  candidateAction   StageCandidateAction
  enabled           Boolean              @default(true)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      Organization         @relation(fields: [organizationId], references: [id])
  machine           Machine?             @relation(fields: [machineId], references: [id])
  autoAppliedSignals StageCandidateSignal[]

  @@index([organizationId, enabled, candidateAction])
  @@index([machineId, candidateAction, enabled])
}

model MachineProfile {
  id                  String       @id @default(cuid())
  organizationId      String
  code                String       @unique
  name                String
  controllerType      String
  fileExtension       String
  units               String
  toolDiameterIn      Decimal      @db.Decimal(8, 3)
  spindleRpm          Int
  feedRateIpm         Int
  plungeRateIpm       Int?
  cutDepthIn          Decimal      @db.Decimal(8, 3)
  onionSkinDepthIn    Decimal      @db.Decimal(8, 3)
  safeZIn             Decimal      @db.Decimal(8, 3)
  defaultCutStrategy  String
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id])
}

model MaterialProfile {
  id                     String           @id @default(cuid())
  organizationId         String
  code                   MaterialCode
  name                   String
  thicknessIn            Decimal          @db.Decimal(8, 3)
  sheetWidthIn           Decimal          @db.Decimal(8, 3)
  sheetDepthIn           Decimal          @db.Decimal(8, 3)
  trimMarginIn           Decimal          @db.Decimal(8, 3)
  defaultEdgeBandPattern EdgeBandPattern
  active                 Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  organization           Organization     @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
}
